# ========================================================
# BiteVote (India Edition) Environment Configuration
# ========================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000

# MongoDB Atlas Database
# Replace with your connection string from cloud.mongodb.com
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=bitevote

# Gemma AI Compromise Engine Configuration
# Production AI: Google Gemma 2 via OpenRouter
# Get your API key at https://openrouter.ai/keys
GEMMA_API_KEY=your_openrouter_api_key_here
GEMMA_API_BASE=https://openrouter.ai/api/v1
GEMMA_MODEL=google/gemma-2-27b-it

